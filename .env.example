# Copy to `.env` (gitignored) and fill in. Never commit real values.
# OpenRouter API key (https://openrouter.ai/keys). Required for the real Brain.
OPENROUTER_API_KEY=

# The one env var that picks the LLM Brain. Optional; defaults to:
# FUTURE_SELF_COACH_MODEL=z-ai/glm-5.3-flash

# ── Voice (ticket 05) ────────────────────────────────────────────────────────
# ElevenLabs API key (https://elevenlabs.io → profile → API keys).
# Instant Voice Clone requires the Starter plan or above; see docs/voice-setup.md.
ELEVENLABS_API_KEY=

# The voice_id of the user's Instant Voice Clone (ElevenLabs dashboard →
# Voices → the clone → copy the ID). Voice stays off until this is set.
FUTURE_SELF_COACH_VOICE_ID=

# Optional TTS model override. Defaults to eleven_flash_v2_5 (~75ms first
# chunk, conversational). Keep Flash unless you have a reason not to.
# FUTURE_SELF_COACH_TTS_MODEL=

# Optional relay port override. Default: 8787
# FUTURE_SELF_COACH_RELAY_PORT=
